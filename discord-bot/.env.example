# Copy this file to ".env" ON THE BOT HOST ONLY and fill it in.
# Never post these values anywhere, never commit them to GitHub.

# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Minecraft RCON (lets the bot send codes in-game, whitelist players, run console commands)
