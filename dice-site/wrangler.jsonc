{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "colorroll-dice",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "colorroll-preview-db",
        "database_id": "a5c8a64d-4a7f-4446-b2dd-4c12cd62065d",
        "migrations_dir": "migrations"
      }
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The API, uploaded pictures and /admin always run the Worker (so /admin can answer
    // "not found"). Addresses that aren't static files also reach the Worker, which is how
    // the secret admin address in the ADMIN_PATH secret works.
    "run_worker_first": ["/api/*", "/media/*", "/admin", "/admin/*", "/vip", "/vip/*"]
  },
  // This database_id is just an identifier for your D1 database (not a password), so it
  // can live in the repo — that lets auto-deploy from GitHub work. If you ever recreate
  // the production database, paste the new id below.
  "d1_databases": [
    { "binding": "DB", "database_name": "colorroll-db", "database_id": "275c4c69-7fde-4187-8e4e-2661124da701", "migrations_dir": "migrations" }
  ],
  "observability": { "enabled": true }
}
