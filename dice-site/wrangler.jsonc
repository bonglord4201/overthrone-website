{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "colorroll-dice",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only the roll API runs the Worker; the page, CSS and JS are plain static files.
    "run_worker_first": ["/api/*"]
  },
  // Created automatically by `wrangler deploy` if it does not exist yet.
  "d1_databases": [
    { "binding": "DB", "database_name": "colorroll-db", "migrations_dir": "migrations" }
  ],
  "observability": { "enabled": true }
}
